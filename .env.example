# Copy to .env and adjust. Never commit .env (it may contain secrets).
APP_ENV=development
# Local development uses SQLite automatically if DATABASE_URL is not set.
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://pskg:CHANGE_ME@localhost:5432/pskg
PUBLIC_URL=http://localhost:8000
SESSION_HOURS=8
COOKIE_SECURE=false
AUTO_MIGRATE=true
MAX_UPLOAD_MB=10
INVITATION_HOURS=72
PASSWORD_RESET_HOURS=2
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Optional SMTP. Leave SMTP_HOST empty to keep e-mails as clearly marked development previews.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pskg.local
SMTP_STARTTLS=true
# Docker Compose only:
POSTGRES_PASSWORD=
